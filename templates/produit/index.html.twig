{% extends 'base.html.twig' %}

{% block title %}Produit index{% endblock %}

{% block body %}
    <style>
        /* Styles pour la page Produit index */
        body {
            font-family: Arial, sans-serif;
            background-color: #f8f9fa;
            padding: 20px;
        }

        h1 {
            color: #333;
            text-align: center;
            margin-bottom: 30px;
        }

        .table {
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
            border-collapse: collapse;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .table thead {
            background-color: #007bff;
            color: #fff;
        }

        .table th, .table td {
            padding: 12px;
            text-align: left;
            border: 1px solid #dddddd;
        }

        .table th {
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .table tbody tr:hover {
            background-color: #f1f1f1;
        }

        .table a {
            color: #007bff;
            text-decoration: none;
            margin-right: 10px;
        }

        .table a:hover {
            color: #0056b3;
            text-decoration: underline;
        }

        .table td {
            font-size: 14px;
        }

        a {
            display: inline-block;
            padding: 10px 20px;
            background-color: #218838;
            color: #fff;
            text-align: center;
            text-decoration: none;
            border-radius: 4px;
            transition: background-color 0.3s ease;
        }

        a:hover {
            background-color: #0056b3;
        }

        .no-records {
            text-align: center;
            padding: 20px;
            font-size: 16px;
            color: #888;
        }

    </style>
    <h1>Produit index</h1>
    <form method="get" action="{{ path('app_produit_index') }}">
        <div class="form-group">
            <label for="search_author">Rechercher par nom Produit :</label>
            <input type="text" name="search_prod" id="search_prod" class="form-control" value="{{ app.request.get('search_prod') }}">
        </div>
        <button type="submit" class="btn btn-primary">Rechercher</button>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prix</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for produit in produits |sort((a, b) => a.prix <= b.prix) %}
            <tr>
                <td>{{ produit.id }}</td>
                <td>{{ produit.nom }}</td>
                <td>{{ produit.prix }}</td>
                <td>
                    <a href="{{ path('app_produit_show', {'id': produit.id}) }}">show</a>
                    <a href="{{ path('app_produit_edit', {'id': produit.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_produit_new') }}">Create new</a>
{% endblock %}
